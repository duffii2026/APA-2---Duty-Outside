# ===== Backend configuration =====
# Copy to .env and adjust (never commit .env)

# HTTP server port for the API
PORT=5000

# MySQL / MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=apa_duty_outside

# CORS: comma separated list of allowed origins (e.g. http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Telegram poller interval in milliseconds (default 6000)
TELEGRAM_POLL_INTERVAL=6000
# AES-256-GCM key for recoverable admin password reveal (generate: openssl rand -hex 32; keep secret and back it up)
PASSWORD_ENCRYPTION_KEY=replace_with_64_hex_characters
