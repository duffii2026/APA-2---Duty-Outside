# ============================================================
# APP 2 - BUILD  (npm run build2)  ->  dist2/
# Served by server.cjs on port 4326 and talking to the server API
# ============================================================

# Production API. Baked into the bundle at build time by api.ts.
VITE_API_BASE=https://dutyoutsideapi.apa2-eva.com/api

# Output folder for this app (used by build2 / server.cjs).
DIST_DIR=dist2

# Static server + reverse proxy settings for this app (server.cjs).
PORT=4326
BACKEND_HOST=dutyoutsideapi.apa2-eva.com
BACKEND_PROTO=https

# Branding shown in the browser title, navbar and login screen.
VITE_APP_NAME=APA 2 - Duty Outside
VITE_APP_BRAND=APA 2
VITE_APP_TITLE=APA 2 - Duty Outside
VITE_APP_DOMAIN=apa2-eva.com
