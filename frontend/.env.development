# ============================================================
# APP 2 - DEV  (npm run dev2)  ->  http://<ip>:4326
# API is called through the Vite dev proxy (/api -> local API)
# ============================================================

# Local backend (npm run dev2 in ../backend) that the Vite proxy forwards to.
DEV_API_TARGET=http://localhost:5005

# Kept for symmetry with build mode; the dev proxy ignores it.
VITE_API_BASE=/api

# Dev server port (also passed via --port in the dev2 script)
FRONTEND_PORT=4326

# Branding shown in the browser title, navbar and login screen.
VITE_APP_NAME=APA 2 - Duty Outside
VITE_APP_BRAND=APA 2
VITE_APP_TITLE=APA 2 - Duty Outside
VITE_APP_DOMAIN=apa2-eva.com
